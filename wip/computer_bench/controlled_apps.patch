+    # ---- test-mode fault hooks (benchmarks/computer_bench.py); every one refuses outside test mode
+    def _require_test_mode(self) -> None:
+        if not self.test_mode:
+            raise PermissionError("fault hooks exist only in test mode")
+
+    def _fault(self, name: str, default=None):
+        return self.faults.get(name, default) if self.test_mode else default
+
+    def _consume_drop(self, app: str) -> bool:
+        drops = self._fault("drop_ack", set())
+        if app in drops:
+            drops.discard(app)
+            return True
+        return False
+
+    def _log_effect(self, c, app: str, kind: str, target_id: int, version_before, detail: dict) -> None:
+        if self.test_mode:
+            c.execute("INSERT INTO effect_log(app,kind,target_id,version_before,detail,at) VALUES (?,?,?,?,?,?)",
+                      (app, kind, target_id, version_before, json.dumps(detail, sort_keys=True), time.time()))
+
+    def set_faults(self, **faults) -> None:
+        self._require_test_mode()
+        unknown = set(faults) - {"load_delay_ms", "drop_ack", "contact_order"}
+        if unknown:
+            raise KeyError(f"unknown fault(s): {sorted(unknown)}")
+        if "drop_ack" in faults:
+            faults["drop_ack"] = set(faults["drop_ack"])
+        self.faults.update(faults)
+
+    def reset(self) -> None:
+        """Restore the seeded records; clear faults, reports, follow-ups and the effect log."""
+        self._require_test_mode()
+        with self._lock, self._conn() as c:
+            for t in ("tasks", "docs", "reports", "contacts", "followups", "effect_log"):
+                c.execute(f"DELETE FROM {t}")
+            c.execute("DELETE FROM sqlite_sequence")
+            c.executemany("INSERT INTO tasks(id,project,title,status,due,owner) VALUES (?,?,?,?,?,?)", TASKS)
+            c.executemany("INSERT INTO docs VALUES (?,?,?,?,?,?)", DOCS)
+            c.executemany("INSERT INTO contacts VALUES (?,?,?,?,?)", CONTACTS)
+        self.faults = {}
+
+    def insert_task(self, project: str, title: str, due: str, owner: str, status: str = "todo") -> int:
+        """Another user adds a task (the board is ordered by due date, so rows can shift)."""
+        self._require_test_mode()
+        with self._lock, self._conn() as c:
+            return c.execute("INSERT INTO tasks(project,title,status,due,owner) VALUES (?,?,?,?,?)", (project, title, status, due, owner)).lastrowid
+
+    def external_edit_task(self, task_id: int, owner: str) -> None:
+        """Another user reassigns the task (its version bumps; row order is unchanged)."""
+        self._require_test_mode()
+        with self._lock, self._conn() as c:
+            c.execute("UPDATE tasks SET owner=?, version=version+1 WHERE id=?", (owner, task_id))
+
+    def revise_document(self, doc_id: int, body: str, updated: str) -> None:
+        """A new version of the document is published in place (same id, version+1)."""
+        self._require_test_mode()
+        with self._lock, self._conn() as c:
+            c.execute("UPDATE docs SET body=?, updated=?, version=version+1 WHERE id=?", (body, updated, doc_id))
